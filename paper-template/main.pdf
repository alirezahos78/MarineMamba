dup 40 /parenleft put
dup 41 /parenright put
dup 43 /plus put
dup 115 /s put
dup 55 /seven put
dup 54 /six put
dup 51 /three put
dup 50 /two put
dup 118 /v put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
