\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces UMAP projections of test-set representations on AQUA20, from raw CLIP features (1--2) through the MarineMamba branches (3--4), the fused classification feature (5), to raw images (6). Frozen CLIP patch features are largely entangled across classes, while MarineMamba's fused representation forms compact, well-separated per-class clusters.}}{16}{figure.caption.9}\protected@file@percent }
\newlabel{fig:umap-aqua20}{{2}{16}{UMAP projections of test-set representations on AQUA20, from raw CLIP features (1--2) through the MarineMamba branches (3--4), the fused classification feature (5), to raw images (6). Frozen CLIP patch features are largely entangled across classes, while MarineMamba's fused representation forms compact, well-separated per-class clusters}{figure.caption.9}{}}
\newlabel{fig:umap-aqua20@cref}{{[figure][2][]2}{[1][15][]16}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces UMAP projections on Sea Animals 23. Visually similar categories (e.g.\ Sea Rays and Sharks) remain nearby but separable in the fused MarineMamba space (panel 5), unlike in the raw CLIP embeddings (panels 1--2).}}{17}{figure.caption.10}\protected@file@percent }
\newlabel{fig:umap-sea23}{{3}{17}{UMAP projections on Sea Animals 23. Visually similar categories (e.g.\ Sea Rays and Sharks) remain nearby but separable in the fused MarineMamba space (panel 5), unlike in the raw CLIP embeddings (panels 1--2)}{figure.caption.10}{}}
\newlabel{fig:umap-sea23@cref}{{[figure][3][]3}{[1][16][]17}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces UMAP projections on Fish4Knowledge under the raw, 881:1-imbalanced split. Despite the extreme imbalance, MarineMamba's fused representation (panel 5) still separates minority-class clusters that are nearly invisible in the raw CLIP embeddings (panels 1--2), which are dominated by a handful of majority classes.}}{18}{figure.caption.11}\protected@file@percent }
\newlabel{fig:umap-fish4k}{{4}{18}{UMAP projections on Fish4Knowledge under the raw, 881:1-imbalanced split. Despite the extreme imbalance, MarineMamba's fused representation (panel 5) still separates minority-class clusters that are nearly invisible in the raw CLIP embeddings (panels 1--2), which are dominated by a handful of majority classes}{figure.caption.11}{}}
\newlabel{fig:umap-fish4k@cref}{{[figure][4][]4}{[1][17][]18}{}{}{}}
