\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Model component ablation on AQUA20. Every variant consumes the same cached CLIP features. ``No Mamba'' replaces the state-space layer with a token-wise feed-forward network, retaining the spatial grid, projections, positional embedding, feature-vector injection and CBAM. The frozen-CLIP MLP row is not an ablation of our head but a reference point: it discards the spatial grid entirely.}}{13}{table.caption.8}\protected@file@percent }
\newlabel{tab:ablation-components}{{6}{13}{Model component ablation on AQUA20. Every variant consumes the same cached CLIP features. ``No Mamba'' replaces the state-space layer with a token-wise feed-forward network, retaining the spatial grid, projections, positional embedding, feature-vector injection and CBAM. The frozen-CLIP MLP row is not an ablation of our head but a reference point: it discards the spatial grid entirely}{table.caption.8}{}}
\newlabel{tab:ablation-components@cref}{{[table][6][]6}{[1][12][]13}{}{}{}}
