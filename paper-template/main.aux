\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of MarineMamba. Frozen CLIP ViT-B/16 and ViT-B/32 encoders extract fine and coarse spatial feature grids together with global CLIP feature vectors. Each resolution's spatial tokens are spiral-reordered and, together with the projected CLIP feature vector, processed by a dedicated MarineMamba branch (Mamba1 for the fine branch, Mamba2 for the coarse branch). The two branch descriptors are concatenated and passed to the classification head.}}{6}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{6}{Overview of MarineMamba. Frozen CLIP ViT-B/16 and ViT-B/32 encoders extract fine and coarse spatial feature grids together with global CLIP feature vectors. Each resolution's spatial tokens are spiral-reordered and, together with the projected CLIP feature vector, processed by a dedicated MarineMamba branch (Mamba1 for the fine branch, Mamba2 for the coarse branch). The two branch descriptors are concatenated and passed to the classification head}{figure.caption.2}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][5][]6}{}{}{}}
