\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces UMAP projection of six embedding spaces on AQUA20 (train $\cdot $, test $\times $). Panels 1--2: frozen CLIP ViT-B/16 and ViT-B/32 grids after mean pooling. Panels 3--5: MarineMamba fine, coarse, and fused fine$\oplus $coarse descriptors. Panel 6: $64\times 64\times 3$ raw-pixel baseline. Species stay entangled in the CLIP and raw-pixel spaces but form compact, largely class-pure clusters in the fused MarineMamba space.}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:umap-aqua20}{{3}{12}{UMAP projection of six embedding spaces on AQUA20 (train $\cdot $, test $\times $). Panels 1--2: frozen CLIP ViT-B/16 and ViT-B/32 grids after mean pooling. Panels 3--5: MarineMamba fine, coarse, and fused fine$\oplus $coarse descriptors. Panel 6: $64\times 64\times 3$ raw-pixel baseline. Species stay entangled in the CLIP and raw-pixel spaces but form compact, largely class-pure clusters in the fused MarineMamba space}{figure.caption.8}{}}
\newlabel{fig:umap-aqua20@cref}{{[figure][3][]3}{[1][12][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces UMAP projection of the same six embedding spaces on Sea Animals~23 (train $\cdot $, test $\times $). The fused MarineMamba space (panel 5) isolates most of the $23$ species into well-separated clusters --- the clearest separation among the three datasets, consistent with the strongest top-1 and macro-F1.}}{13}{figure.caption.9}\protected@file@percent }
\newlabel{fig:umap-sea23}{{4}{13}{UMAP projection of the same six embedding spaces on Sea Animals~23 (train $\cdot $, test $\times $). The fused MarineMamba space (panel 5) isolates most of the $23$ species into well-separated clusters --- the clearest separation among the three datasets, consistent with the strongest top-1 and macro-F1}{figure.caption.9}{}}
\newlabel{fig:umap-sea23@cref}{{[figure][4][]4}{[1][12][]13}{}{}{}}
